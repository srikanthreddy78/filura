{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme CRM",
    "version": "1.4.0",
    "description": "Internal CRM REST API — not MCP-wrapped, ingested via OpenAPI."
  },
  "paths": {
    "/customers": {
      "get": {
        "operationId": "listCustomers",
        "summary": "List CRM customers, optionally filtered by a search term.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "customers": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Customer" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}": {
      "get": {
        "operationId": "getCustomer",
        "summary": "Get a CRM customer by id.",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Customer" }
              }
            }
          }
        }
      }
    },
    "/customers/{customer_id}/tickets": {
      "post": {
        "operationId": "createTicket",
        "summary": "Open a support ticket for a customer.",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": { "type": "string" },
                  "priority": {
                    "type": "string",
                    "enum": ["low", "normal", "high", "urgent"]
                  },
                  "description": { "type": "string" }
                },
                "required": ["subject"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created ticket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket_id": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_id}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Get a support ticket by id.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket_id": { "type": "string" },
                    "status": { "type": "string" },
                    "subject": { "type": "string" },
                    "customer_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/escalation-levels": {
      "get": {
        "operationId": "listEscalationLevels",
        "summary": "List available escalation levels.",
        "responses": {
          "200": {
            "description": "Escalation levels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "levels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "escalation_level_id": { "type": "string" },
                          "label": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_id}/escalate": {
      "post": {
        "operationId": "escalateTicket",
        "summary": "Escalate a support ticket.",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": { "type": "string" },
                  "escalation_level_id": { "type": "string" }
                },
                "required": ["reason", "escalation_level_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Escalated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket_id": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/messages": {
      "post": {
        "operationId": "postMessage",
        "summary": "Post a message to a channel. NOTE: near-duplicate of slack.post_message — planted redundancy.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channel_id": { "type": "string" },
                  "text": { "type": "string" }
                },
                "required": ["channel_id", "text"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Posted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message_ts": { "type": "string" },
                    "channel_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}": {
      "get": {
        "operationId": "getInvoice",
        "summary": "Get an invoice by id. NOTE: nothing in this catalog produces an invoice_id — planted dead node.",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoice_id": { "type": "string" },
                    "amount_due": { "type": "number" },
                    "currency": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Customer": {
        "type": "object",
        "properties": {
          "customer_id": { "type": "string", "description": "Unique CRM customer id" },
          "company_name": { "type": "string" },
          "plan": { "type": "string" },
          "owner_email": { "type": "string", "format": "email" }
        }
      }
    }
  }
}
