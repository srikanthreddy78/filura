  "retrieval": {
    "$comment": "Per goal: `required` tools must ALL appear in the retrieved subgraph; each `anyOf` group must contribute at least one tool. These encode the dependency closure a correct answer needs, not merely the most similar tools.",
    "maxTools": 8,
    "goals": [
      {
        "goal": "create a jira issue in the right project",
        "required": [
          "jira.createIssue",
          "jira.listIssueTypes"
        ],
        "anyOf": [
          [
            "jira.listProjects",
            "jira.getProject"
          ]
        ]
      },
      {
        "goal": "escalate an urgent support ticket for a customer",
        "required": [
          "acme-crm.escalateTicket",
          "acme-crm.listEscalationLevels"
        ],
        "anyOf": [
          [
            "acme-crm.getTicket",
            "acme-crm.createTicket"
          ]
        ]
      },
      {
        "goal": "assign a jira issue to a user",
        "required": [
          "jira.assignIssue",
          "jira.searchUsers"
        ],
        "anyOf": []
      },
      {
        "goal": "post a message in a slack channel",
        "required": [
          "slack.post_message"
        ],
        "anyOf": [
          [
            "slack.list_channels",
            "slack.open_dm"
          ]
        ]
      },
      {
        "goal": "reply to a slack message thread",
        "required": [
          "slack.reply_in_thread"
        ],
        "anyOf": [
          [
            "slack.post_message"
          ],
          [
            "slack.list_channels",
            "slack.open_dm"
          ]
        ]
      },
      {
        "goal": "comment on a github issue",
        "required": [
          "github.add_issue_comment"
        ],
        "anyOf": [
          [
            "github.list_issues",
            "github.get_issue",
            "github.create_issue"
          ],
          [
            "github.list_repos",
            "github.get_repo"
          ]
        ]
      },
      {
        "goal": "move a jira ticket to a done state",
        "required": [
          "jira.transitionIssue",
          "jira.listTransitions"
        ],
        "anyOf": []
      },
      {
        "goal": "merge a github pull request",
        "required": [
          "github.merge_pull_request",
